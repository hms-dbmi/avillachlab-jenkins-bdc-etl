  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash
set -euo pipefail

export DMC_BUCKETS=&quot;${dmc_buckets}&quot;
export STUDY_ABBREVIATION=&quot;${study_abbreviation,,}&quot;
export STUDY_PHS=&quot;${study_phs}&quot;
export VERSION=&quot;${version}&quot;
export PHASE=&quot;${phase}&quot;
export STUDY_FULL_NAME=&quot;${study_full_name}&quot;
export LOCAL=&quot;false&quot;

# ---- Python venv in workspace ----
VENV_DIR=&quot;${VENV_DIR:-.venv}&quot;
python3 -m venv &quot;$VENV_DIR&quot;
# shellcheck disable=SC1090
source &quot;$VENV_DIR/bin/activate&quot;

python -m pip install -U pip wheel

# ---- Install deps explicitly (no pyproject/setup.py) ----
python -m pip install \
  boto3 botocore s3fs requests \
  jsonschema \
  pandas \
  lxml \
  pyreadstat

# quick sanity
python -c &quot;import pyreadstat, pandas, lxml; print(&apos;deps ok&apos;)&quot;

# run your existing pipeline script (it will use venv python)
bash ./multi_mappings/pipeline.sh</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>

  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash
set -euo pipefail
set -x   # echo each command so the log shows what actually ran

# Strip any accidental whitespace from the parameter
bucket=&quot;$(echo &quot;${bucket_s3_name}&quot; | tr -d &apos;[:space:]&apos;)&quot;

mkdir -p downloads

# Get credentials directly as text instead of grepping JSON
read -r AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN &lt; &lt;(
  aws sts assume-role \
    --role-arn &quot;arn:aws:iam::${nhlbi_account_number}:role/nih-nhlbi-TopMed-EC2Access-S3&quot; \
    --role-session-name &quot;get-phenotypic-data&quot; \
    --query &apos;Credentials.[AccessKeyId,SecretAccessKey,SessionToken]&apos; \
    --output text
)
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN

aws s3 cp &quot;s3://${bucket}&quot; ./downloads/ --recursive</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
